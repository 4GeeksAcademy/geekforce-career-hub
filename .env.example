# Railway sets DATABASE_URL automatically when you add a Postgres service and reference it.
DATABASE_URL=postgresql://gf:gf@localhost:5432/geekforce
JWT_SECRET=generate-a-long-random-string
APP_URL=https://career-hub-production-dc19.up.railway.app
TIMEZONE=America/New_York
ENABLE_SCHEDULER=true
CRON_SECRET=another-long-random-string

# First admin account (created on startup if it doesn't exist). They sign in with the 4Geeks account
# that uses this email. INITIAL_ADMIN_PASSWORD only works with DEV_PASSWORD_LOGIN (local development).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=GeekForce Admin

# Brevo (emails). Sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=geekforce@4geeksacademy.com
BREVO_SENDER_NAME=GeekForce Career Hub

# Claude API (resume builder)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Notion roster sync (read-only). Create an internal integration at notion.so/my-integrations, then share
# "Miami Student Tracker | Part-Time" and "GeekForce student's tasks" with it.
NOTION_TOKEN=
NOTION_STUDENTS_SOURCE_ID=f6fd23c5-65be-4d01-814c-981ae43174ea

# Sign-in: everyone uses their 4Geeks (Breathcode) account (hosted login or GitHub).
BREATHCODE_API_URL=https://breathecode.herokuapp.com
# Local development only: shows an email + password form for the demo accounts. Never in production.
DEV_PASSWORD_LOGIN=false

# Demo data (Maria González, Valentina, etc. — password geekforce-demo). Never in production.
SEED_DEMO=false
