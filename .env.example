# Railway sets DATABASE_URL automatically when you add a Postgres service and reference it.
DATABASE_URL=postgresql://gf:gf@localhost:5432/geekforce
JWT_SECRET=generate-a-long-random-string
APP_URL=https://geekforce-career-hub.up.railway.app
TIMEZONE=America/New_York
ENABLE_SCHEDULER=true
CRON_SECRET=another-long-random-string

# First admin account (created on startup if it doesn't exist)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=GeekForce Admin

# Brevo (emails). Sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=geekforce@4geeksacademy.com
BREVO_SENDER_NAME=GeekForce Career Hub

# Claude API (resume builder)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Phase 2: sign in with 4Geeks (Breathcode)
BREATHCODE_ENABLED=false
BREATHCODE_API_URL=https://breathecode.herokuapp.com

# Demo data (Maria González, Valentina, etc. — password geekforce-demo). Never in production.
SEED_DEMO=false
